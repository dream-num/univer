{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "transit": {
            "dependsOn": ["^transit"]
        },

        "test": {
            "dependsOn": ["transit"]
        },

        "coverage": {
            "dependsOn": ["transit"],
            "outputs": ["coverage/**"],
            "env": ["CI"]
        },

        "build": {
            "outputs": ["lib/**"]
        },

        "typecheck": {}
    }
}
